{
  "name": "@asolutions/nuxt-base",
  "version": "0.1.0",
  "description": "Nuxt Layer com as partes comuns dos apps da ASolutions: observabilidade no GlitchTip, autenticação OIDC, saúde e cabeçalhos de segurança",
  "type": "module",
  "main": "./nuxt.config.ts",
  "files": [
    "nuxt.config.ts",
    "layers",
    "app",
    "server",
    "shared",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev .playground",
    "build": "nuxt build .playground",
    "prepare": "nuxt prepare .playground",
    "typecheck": "nuxt typecheck .playground",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "peerDependencies": {
    "nuxt": "^4.6.0"
  },
  "dependencies": {
    "@sentry/node": "11.12.0",
    "@sentry/vue": "11.12.0",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/nuxt": "1.1.1",
    "openid-client": "6.9.0",
    "web-push": "3.6.7",
    "workbox-cacheable-response": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.4.0",
    "@types/node": "^22.20.5",
    "nuxt": "4.6.4",
    "oauth2-mock-server": "9.3.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "vue": "3.5.45",
    "vue-router": "5.5.0",
    "vue-tsc": "3.3.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/argel-sosa90/nuxt-base.git"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./auth": "./layers/auth/nuxt.config.ts",
    "./mail": "./layers/mail/nuxt.config.ts",
    "./pwa": "./layers/pwa/nuxt.config.ts",
    "./push": "./layers/push/nuxt.config.ts",
    "./push/server": "./layers/push/server/utils/push.ts",
    "./sw": "./layers/pwa/service-worker/core.ts",
    "./sw/push": "./layers/push/service-worker/push.ts",
    "./package.json": "./package.json"
  }
}
