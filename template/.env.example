# Copie para .env. O .env nunca é versionado. Em produção, os segredos vêm do
# Infisical (projeto do app, environment prod) como referências no Dokploy.

# --- App ---
# URL pública: origem esperada nos POST, redirect_uri do login e cookie Secure.
APP_URL=http://localhost:3000
# Ambiente dos eventos do GlitchTip; as regras de alerta filtram por `production`.
APP_ENV=development

# --- Banco ---
DATABASE_URL=postgres://app:app@localhost:5432/app
# Usado só por `npm test` (serviço db-test do compose). Os testes truncam tabelas.
TEST_DATABASE_URL=postgres://app:app@localhost:5433/app_test
# RUN_MIGRATIONS=false

# --- Login (OIDC) ---
# Qualquer IdP OIDC: Zitadel, Authentik, Keycloak, Pocket ID...
# Redirect URI a cadastrar no IdP:            <APP_URL>/auth/callback
# Post-logout redirect URI a cadastrar no IdP: <APP_URL>/ (ou o `auth.afterLogout`)
# Zitadel local (zitadel-dokploy): http://localhost:8088
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Vazio: cliente público (só PKCE). Com valor: client_secret_basic.
OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Recusa quem não confirmou o e-mail no IdP (padrão: true).
# OIDC_REQUIRE_EMAIL_VERIFIED=true

# Cifra o cookie de sessão; 32+ caracteres. Em desenvolvimento, sem ele, um
# segredo aleatório por subida é usado (as sessões caem a cada reinício).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Duração da sessão, contada do login (padrão: 7). Um usuário desativado no IdP
# continua logado aqui até ela expirar.
# SESSION_MAX_AGE_DAYS=7

# --- Observabilidade (GlitchTip) ---
# Sem o DSN nada é enviado e nenhuma conexão é aberta. Só o servidor o lê; o
# navegador envia pela rota /api/telemetry.
# GLITCHTIP_DSN=https://<chave>@glitchtip.asolutions.dev/<id>
# Fração das requisições medidas (0 a 1; 0 desliga o desempenho e mantém os erros).
# GLITCHTIP_TRACES_SAMPLE_RATE=0.1

# --- E-mail (Zoho CPaaS) ---
# Sem a chave ou o remetente o e-mail fica desligado: `sendMail` devolve false.
# A chave é a do agente de envio deste app no CPaaS (aba API do agente).
ZOHO_CPAAS_API_KEY=
# Só mude se a conta for de outra região.
# ZOHO_CPAAS_URL=https://cpaas.zoho.com/v1.1/email
MAIL_FROM_ADDRESS=nao-responda@asolutions.dev
MAIL_FROM_NAME=Meu App

# --- Push (Web Push / VAPID) ---
# Sem as chaves o push fica desligado; o app segue inteiro.
# Gere um par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelos serviços de push (padrão: APP_URL, se https).
# VAPID_SUBJECT=mailto:voce@asolutions.dev
